# Local development only. Do not reuse these credentials in staging or production.
DATABASE_URL="postgresql://photobooth:photobooth@localhost:5432/photobooth?schema=public"
HOST="127.0.0.1"
PORT="4000"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_ORIGIN="http://127.0.0.1:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SHARE_CONSENT_VERSION="2026-10-02"
SHARE_TTL_HOURS="72"
SHARE_MAX_BYTES="10485760"
SHARE_RATE_LIMIT_MAX="5"

# Optional remote-camera relay. Configure either Coturn or Metered, not both.
TURN_URLS=""
TURN_SHARED_SECRET=""
TURN_CREDENTIAL_TTL_SECONDS="900"
METERED_TURN_APP_NAME=""
METERED_TURN_API_KEY=""

# Optional cloud sharing. Leave all S3 values blank to keep cloud sharing disabled.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Optional public/CDN origin for catalog art. Never place photo share objects here.
ASSET_PUBLIC_BASE_URL=""
